#!/bin/sh
set -e
# Run html-to-text to convert all html files to text files
DIR_MAILS="../backend/core/templates/mail/"

if [ ! -d "${DIR_MAILS}" ]; then
  mkdir -p "${DIR_MAILS}";
fi

if [ ! -d "${DIR_MAILS}"html/ ]; then
  mkdir -p "${DIR_MAILS}"html/;
  exit;
fi

for file in "${DIR_MAILS}"html/*.html;
    do html-to-text -j ./html-to-text.config.json < "$file" > "${file%.html}".txt; done;

if [ ! -d "${DIR_MAILS}"text/ ]; then
  mkdir -p "${DIR_MAILS}"text/;
fi

mv "${DIR_MAILS}"html/*.txt "${DIR_MAILS}"text/;

# Plain-text fallback for summary_preview_html: raw HTML in a .txt mail is
# unreadable, so substitute the markdown source variable.
TRANSCRIPTION_TXT="${DIR_MAILS}text/transcription.txt"
if [ -f "${TRANSCRIPTION_TXT}" ]; then
  # node, not python3: the mail-builder image (node:*-alpine) has no python.
  node -e '
const fs = require("fs");
const p = process.argv[1];
fs.writeFileSync(
  p,
  fs.readFileSync(p, "utf8").replace(
    /\{\{ summary_preview_html\|safe \}\}/g,
    () => "{% if summary_preview %}{{ summary_preview|truncatewords:100 }}{% endif %}",
  ),
);
' "${TRANSCRIPTION_TXT}"
fi
